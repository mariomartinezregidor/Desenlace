# Copia este archivo como .env y rellena los valores que necesites.
# No subas nunca el archivo .env a GitHub ni lo compartas.
#
# Recomendado: en lugar de guardar los datos de Telegram aquí, usa
#   python3 desenlace.py setup
# que los guarda en el llavero de tu sistema.

# --- Telegram (sólo para bots de Telegram) ---------------------------------
TELEGRAM_API_ID=tu_api_id_aqui
TELEGRAM_API_HASH=tu_api_hash_aqui
TELEGRAM_SESSION_STRING=tu_session_string_aqui

# --- Opciones opcionales ---------------------------------------------------
# Límite de redirecciones por petición (por defecto 10).
DESENLACE_MAX_REDIRECTS=10

# Tiempo máximo en segundos para el flujo del navegador (por defecto 120).
DESENLACE_BROWSER_TIMEOUT=120

# Permitir redes locales. Déjalo en 0. Sólo para pruebas propias.
DESENLACE_ALLOW_PRIVATE=0
