# Copia este archivo a .env (o exporta las variables en tu shell).
# NO subas nunca el .env real al repositorio.

# --- Telegram (opcional) ---------------------------------------------------
# Se obtienen en https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sesión de Telethon ya autorizada. Genérala una vez con:
#   python - <<'PY'
#   from telethon.sync import TelegramClient
#   from telethon.sessions import StringSession
#   with TelegramClient(StringSession(), API_ID, API_HASH) as c:
#       print(c.session.save())
#   PY
# Formato: 1BVtsOK... (cadena larga)
TELEGRAM_SESSION_STRING=

# --- Opciones del motor (opcionales) --------------------------------------
# Límite estricto de redirecciones HTTP por petición.
# DESENLACE_MAX_REDIRECTS=10

# Timeout (segundos) del flujo multi-click/anti-bot.
# DESENLACE_BROWSER_TIMEOUT=120

# Sólo para pruebas locales: permite IPs privadas (desactiva SSRF).
# DESENLACE_ALLOW_PRIVATE=0
